{
  "name": "@kanbun/skam-web-component",
  "version": "0.1.0",
  "description": "SKAM Web Component - <skam-renderer> カスタムエレメント",
  "type": "module",
  "sideEffects": [
    "./dist/auto.js",
    "./src/auto.ts"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./auto": {
      "import": "./dist/auto.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint src",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "kanbun",
    "漢文",
    "annotation",
    "skam",
    "web-component",
    "custom-element"
  ],
  "author": "berlysia",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berlysia/kanbun-annotation.git",
    "directory": "packages/skam-web-component"
  },
  "bugs": {
    "url": "https://github.com/berlysia/kanbun-annotation/issues"
  },
  "homepage": "https://github.com/berlysia/kanbun-annotation/tree/master/packages/skam-web-component#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@kanbun/skam-xml-parser": "workspace:*",
    "@kanbun/skam-html-renderer": "workspace:*"
  }
}
