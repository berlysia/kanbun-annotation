{
  "name": "kanbun-annotation",
  "version": "0.1.0",
  "private": true,
  "description": "Stand-off Kanbun Annotation Model - 漢文アノテーションの仕様定義・構文定義・レンダラー",
  "keywords": [
    "annotation",
    "classical-chinese",
    "kanbun",
    "漢文"
  ],
  "license": "MIT",
  "author": "berlysia",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "turbo test",
    "test:run": "turbo test:run",
    "test:semantic": "pnpm --filter @kanbun-skam/integration-tests test:semantic",
    "test:visual": "pnpm --filter @kanbun-skam/integration-tests test:visual",
    "test:visual:docker": "node scripts/vrt-docker.ts",
    "test:consumer": "pnpm build && pnpm --filter @kanbun-skam/integration-tests test:consumer",
    "clean": "knip",
    "playground:dev": "pnpm --filter @kanbun-skam/playground dev",
    "playground:build": "turbo build --filter=@kanbun-skam/playground",
    "playground:preview": "pnpm --filter @kanbun-skam/playground preview",
    "baseline": "pnpm --filter @kanbun-skam/baseline-check check",
    "baseline:report": "pnpm --filter @kanbun-skam/baseline-check report",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "screenshot": "turbo build --filter=@kanbun-skam/skam-screenshot && node packages/skam-screenshot/dist/cli.js",
    "typecheck:scripts": "tsgo -p scripts/tsconfig.json",
    "test:scripts": "node --test \"scripts/**/*.test.ts\"",
    "verify": "pnpm adr:check && pnpm build && pnpm typecheck && pnpm typecheck:scripts && pnpm lint && pnpm format:check && pnpm test:run && pnpm test:scripts && pnpm clean && pnpm test:consumer",
    "release": "node scripts/release.ts",
    "adr:status": "node scripts/adr-status.ts",
    "adr:check": "node scripts/adr-status.ts --check",
    "adr:deps": "node scripts/adr-deps.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/node": "25.0.10",
    "@typescript/native-preview": "7.0.0-dev.20260122.4",
    "happy-dom": "20.14.6",
    "husky": "9.1.7",
    "knip": "5.82.1",
    "lint-staged": "16.2.7",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "tsup": "8.5.1",
    "turbo": "2.8.1",
    "typescript5": "npm:typescript@5.9.3",
    "vitest": "4.0.18",
    "yaml": "2.8.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,html,css}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@10.27.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@anthropic-ai/tokenizer-wasm"
    ]
  }
}
