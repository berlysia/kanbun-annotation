{
  "name": "kanbun-annotation",
  "version": "0.1.0",
  "private": true,
  "description": "Stand-off Kanbun Annotation Model - 漢文アノテーションの仕様定義・構文定義・レンダラー",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:run": "pnpm -r test:run",
    "clean": "knip",
    "playground:dev": "pnpm --filter @kanbun/playground dev",
    "playground:build": "pnpm --filter @kanbun/playground build",
    "playground:preview": "pnpm --filter @kanbun/playground preview",
    "baseline": "pnpm --filter @kanbun/baseline-check check",
    "baseline:report": "pnpm --filter @kanbun/baseline-check report",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "screenshot": "pnpm --filter @kanbun/skam-screenshot build && node packages/skam-screenshot/dist/cli.js",
    "prepare": "husky"
  },
  "keywords": [
    "kanbun",
    "漢文",
    "annotation",
    "classical-chinese"
  ],
  "author": "berlysia",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.27.0",
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/node": "25.0.10",
    "@typescript/native-preview": "7.0.0-dev.20260122.4",
    "happy-dom": "20.3.9",
    "husky": "9.1.7",
    "knip": "5.82.1",
    "lint-staged": "16.2.7",
    "oxlint": "1.41.0",
    "prettier": "3.8.1",
    "tsup": "8.5.1",
    "vitest": "4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@anthropic-ai/tokenizer-wasm"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,html,css}": "prettier --write"
  }
}
