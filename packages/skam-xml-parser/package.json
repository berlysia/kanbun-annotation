{
  "name": "@kanbun-skam/skam-xml-parser",
  "version": "0.1.1",
  "description": "SKAM-ML/XML parser - SKAM-ML/XMLからSKAM JSONへのパーサー",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "import": "./dist/index.browser.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint src",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "kanbun",
    "漢文",
    "annotation",
    "skam",
    "xml"
  ],
  "author": "berlysia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berlysia/kanbun-annotation.git",
    "directory": "packages/skam-xml-parser"
  },
  "bugs": {
    "url": "https://github.com/berlysia/kanbun-annotation/issues"
  },
  "homepage": "https://github.com/berlysia/kanbun-annotation/tree/master/packages/skam-xml-parser#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@kanbun-skam/skam": "workspace:*",
    "@xmldom/xmldom": "0.8.15"
  }
}
