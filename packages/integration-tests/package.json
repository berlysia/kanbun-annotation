{
  "name": "@kanbun-skam/integration-tests",
  "version": "0.1.0",
  "private": true,
  "description": "Integration tests for SKAM packages (round-trip parse/stringify)",
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "bench": "node src/fixtures/kojiki/update-source.ts && vitest bench --run",
    "test:semantic": "vitest run cross-renderer-equivalence",
    "test:visual": "playwright test",
    "test:consumer": "node consumer/run.mjs",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@kanbun-skam/skam": "workspace:*",
    "@kanbun-skam/skam-canvas-renderer": "workspace:*",
    "@kanbun-skam/skam-html-renderer": "workspace:*",
    "@kanbun-skam/skam-screenshot": "workspace:*",
    "@kanbun-skam/skam-web-component": "workspace:*",
    "@kanbun-skam/skam-xml-parser": "workspace:*",
    "@kanbun-skam/skam-xml-stringify": "workspace:*",
    "@playwright/test": "1.58.0"
  }
}
