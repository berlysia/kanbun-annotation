{
  "name": "@kanbun-skam/skam-html-renderer",
  "version": "0.2.0",
  "description": "SKAM to HTML renderer - SKAMドキュメントから静的HTMLを生成",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint -c .oxlintrc.json src && stylelint 'src/**/*.ts'",
    "lint:baseline": "pnpm lint:baseline:css; pnpm lint:baseline:js",
    "lint:baseline:css": "stylelint 'src/**/*.ts'",
    "lint:baseline:js": "oxlint -c .oxlintrc.baseline.json src",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "kanbun",
    "漢文",
    "annotation",
    "skam",
    "html",
    "renderer"
  ],
  "author": "berlysia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berlysia/kanbun-annotation.git",
    "directory": "packages/skam-html-renderer"
  },
  "bugs": {
    "url": "https://github.com/berlysia/kanbun-annotation/issues"
  },
  "homepage": "https://github.com/berlysia/kanbun-annotation/tree/master/packages/skam-html-renderer#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@kanbun-skam/skam": "workspace:*"
  },
  "devDependencies": {
    "@kanbun-skam/skam-xml-parser": "workspace:*",
    "eslint": "9.39.2",
    "eslint-plugin-baseline-js": "^0.5.0",
    "postcss-styled-syntax": "^0.7.1",
    "stylelint": "^16.26.1",
    "stylelint-plugin-use-baseline": "^1.2.1"
  }
}
