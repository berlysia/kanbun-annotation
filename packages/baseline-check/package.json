{
  "name": "@kanbun-skam/baseline-check",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web Platform Baseline compatibility checker for SKAM CSS/JS outputs",
  "scripts": {
    "extract": "node scripts/extract-css.js",
    "check:js-baseline": "oxlint -c .oxlintrc.baseline.json extracted/js/*.js",
    "check:stylelint": "stylelint 'extracted/css/**/*.css'",
    "check": "pnpm extract && pnpm check:stylelint; pnpm check:js-baseline",
    "check:css": "pnpm extract && pnpm check:stylelint",
    "check:js": "pnpm extract && pnpm check:js-baseline",
    "report": "node scripts/generate-report.js ../../docs/baseline-compatibility.md",
    "check:overrides": "node scripts/check-overrides.js"
  },
  "devDependencies": {
    "eslint": "9.39.2",
    "eslint-plugin-baseline-js": "0.5.0",
    "stylelint": "17.0.0",
    "stylelint-plugin-use-baseline": "1.2.1"
  }
}
