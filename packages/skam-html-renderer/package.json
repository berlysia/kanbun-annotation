{
  "name": "@kanbun/skam-html-renderer",
  "version": "0.1.0",
  "description": "SKAM to HTML renderer - SKAMドキュメントから静的HTMLを生成",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint src",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "kanbun",
    "漢文",
    "annotation",
    "skam",
    "html",
    "renderer"
  ],
  "license": "MIT",
  "dependencies": {
    "@kanbun/skam": "workspace:*"
  }
}
