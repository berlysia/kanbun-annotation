{
  "name": "@kanbun/skam-html-renderer",
  "version": "0.1.0",
  "description": "SKAM to HTML renderer - SKAMドキュメントから静的HTMLを生成",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint src",
    "lint:baseline": "pnpm lint:baseline:css; pnpm lint:baseline:js",
    "lint:baseline:css": "stylelint 'src/**/*.ts'",
    "lint:baseline:js": "eslint -c eslint-baseline.config.js 'src/**/*.ts'",
    "test": "vitest",
    "test:run": "vitest run",
    "check:deps": "bash check-deps.sh"
  },
  "keywords": [
    "kanbun",
    "漢文",
    "annotation",
    "skam",
    "html",
    "renderer"
  ],
  "author": "berlysia",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berlysia/kanbun-annotation.git",
    "directory": "packages/skam-html-renderer"
  },
  "bugs": {
    "url": "https://github.com/berlysia/kanbun-annotation/issues"
  },
  "homepage": "https://github.com/berlysia/kanbun-annotation/tree/master/packages/skam-html-renderer#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@kanbun/skam": "workspace:*"
  },
  "devDependencies": {
    "@kanbun/skam-xml-parser": "workspace:*",
    "eslint": "^9.39.2",
    "eslint-plugin-baseline-js": "^0.5.0",
    "postcss-styled-syntax": "^0.7.1",
    "stylelint": "^16.26.1",
    "stylelint-plugin-use-baseline": "^1.2.1",
    "typescript-eslint": "8.54.0"
  }
}
