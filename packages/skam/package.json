{
  "name": "@kanbun-skam/skam",
  "version": "0.1.1",
  "description": "Stand-off Kanbun Annotation Model - 漢文アノテーションの意味モデル型定義",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./rendering": {
      "import": "./dist/rendering/index.js",
      "types": "./dist/rendering/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint src",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "kanbun",
    "漢文",
    "annotation",
    "classical-chinese",
    "skam"
  ],
  "author": "berlysia",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/berlysia/kanbun-annotation.git",
    "directory": "packages/skam"
  },
  "bugs": {
    "url": "https://github.com/berlysia/kanbun-annotation/issues"
  },
  "homepage": "https://github.com/berlysia/kanbun-annotation/tree/master/packages/skam#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
